{
  "name": "kira-kira-overdrive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --fsModuleCache=false --testTimeout=60000",
    "balance": "vitest run --config tools/vitest.balance.config.ts --root . --fsModuleCache=false --disableConsoleIntercept",
    "shot": "node scripts/shot.mjs",
    "sprites": "node scripts/sprites.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0"
  }
}
